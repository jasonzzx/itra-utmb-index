# Optional. Routes outbound requests to ITRA and UTMB through an HTTP proxy.
#
# ITRA is fronted by AWS WAF Bot Control, which challenges traffic from
# datacenter IP ranges — including Vercel's serverless egress. If ITRA lookups
# come back with "AWS WAF bot challenge", point this at a proxy whose exit IP
# isn't in a datacenter range.
#
# Leave unset to make requests directly. UTMB does not need this.
# OUTBOUND_PROXY_URL=http://user:pass@proxy.example.com:8080
